<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ATIP.Management.Views.DashboardPage"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Label
                Text="ATIP Management"
                FontSize="32"
                FontAttributes="Bold" />

            <Label
                Text="ACTDF Talent Intelligence Platform"
                FontSize="18" />

            <Label
                Text="Management Dashboard"
                FontSize="24"
                Margin="0,20,0,0" />

            <Label
                Text="Your ATIP command center will appear here."
                FontSize="16" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
